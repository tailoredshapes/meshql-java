{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "container_id",
    "source_type",
    "source_id",
    "eggs",
    "timestamp"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "container_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "eggs": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string"
    }
  }
}
