{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "container_type",
    "capacity",
    "zone"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "container_type": {
      "type": "string"
    },
    "capacity": {
      "type": "integer"
    },
    "zone": {
      "type": "string"
    }
  }
}
